[worldserver]

###################################################################################################
# INDIVIDUAL RATES MODULE
#
# This module lets players choose their own progression and reward multipliers with `.rate`.
# It is intended as a replacement for the older individual XP-only module: XP rates are still
# supported, but the system now also covers skill gains, reputation, PvP rewards, selected item
# drop chances, and loot money.
#
# Important worldconfig warning:
#   This module multiplies the values produced by AzerothCore after worldserver.conf rates are
#   applied. For predictable player-facing rates, set the matching worldserver.conf rates to x1
#   and let this module control personal rates.
#
#   Example: if worldserver.conf Rate.XP.Kill = 2 and a player sets xp.kill = 3, the final kill XP
#   is effectively x6. This is usually not what owners want for an individual rate system.
#
# How it works:
#   - Server owners decide which categories and individual rates are available.
#   - A category key is a bulk command target, not a separately stored rate. Example:
#       `.rate set xp 5` sets all enabled XP rates to x5.
#       `.rate set xp.bg.av 2` can then set only Alterac Valley kill XP to x2.
#       The individual value takes over because the category command only bulk-writes rates.
#   - Players can only see and change rates that are enabled in this config.
#   - `Enabled` controls command availability. It does not directly force a rate value.
#   - `Default` controls the value used when no account or character override exists.
#   - Decimal values are allowed in commands and config, such as 1.3, 1.5, or 0.5.
#     Use a dot for decimals, not a comma.
#   - Account rates are the default player-facing path in this config.
#   - Character-specific overrides can be enabled separately. When a character override exists for
#     a rate, it has higher priority than the account value for that same rate.
#   - Account unlocks and MaxLevel caps are separate systems. Account unlocks use the highest
#     character level on the account; MaxLevel caps use the current character's level.
#
# Player commands:
#   .rate help
#       Show the in-game command summary.
#
#   .rate view
#       Show the player's currently changeable rates. Disabled categories/rates are hidden.
#
#   .rate list
#       Show available rate keys and category keys.
#
#   .rate set <key|category> <value>
#       Set one rate, or set all enabled rates in a category. By default this writes account rates.
#       Example: .rate set xp.kill 2
#       Example: .rate set xp 5
#
#   .rate setall <category> <value>
#       Set all enabled rates in a category.
#       Example: .rate setall drops 2
#
#   .rate account set <key|category> <value>
#       Set an account-wide override when IndividualRates.AccountRates.Enabled is 1.
#
#   .rate character set <key|category> <value>
#       Set a character-specific override when IndividualRates.CharacterRates.Enabled is 1.
#       Character overrides have higher priority than account values.
#
#   .rate default <key>
#       Reset one rate for the default storage target used by `.rate set`.
#
#   .rate character reset <key|category>
#       Remove one character-specific override so the character uses the account value or server
#       default again.
#
#   .rate reset <key|category>
#       Remove account and character overrides so the server-configured Default is used.
#
#   .rate enable <key> / .rate disable <key>
#       Toggle one personal rate on or off. `.rate on` and `.rate off` are aliases.
#
#   .rate lock / .rate unlock
#       Disable or enable XP gain for the character. In account-rate mode, the XP lock is shared
#       across the account.
#
# XP level bracket defaults:
#   The XP level bracket rates multiply with XP source rates. For example, if xp.kill is x2 and
#   xp.level.20-29 is x0.5, kill XP from level 20 through 29 becomes x1 overall.
#
#   Enabled only allows players to use the bracket command. The Default value still applies when
#   no player override exists, so owners can make level brackets automatically change leveling
#   speed by changing each bracket's Default.
#
# Owner controls:
#   Every category and every individual rate can define:
#
#   Enabled
#       1 - Players may view, enable/disable, and change this rate.
#       0 - The rate is unavailable to players, even if saved character data exists.
#
#   Default
#       The value assigned to new characters and restored by `.rate default <key>`.
#       A value of 1 means normal AzerothCore behavior after the worldserver.conf rate is applied.
#
#   Max
#       The highest value players may set with `.rate set <key> <value>`.
#
#   Unlock.Enabled / Unlock.Level / Unlock.Steps
#       Optional account progression requirement. This is separate from MaxLevel.
#       Requires IndividualRates.AccountUnlocks.Enabled = 1.
#       Uses the highest-level character on the account.
#       Steps use Rate:RequiredAccountLevel, for example:
#           2:10,3:20,4:30,5:40,6:50,7:60,8:70,9:80
#
#       Keep Steps empty to use Unlock.Level. If Steps is filled in, Steps always takes priority
#       over Unlock.Level.
#
#   MaxLevel.Enabled / MaxLevel.Level / MaxLevel.MaxRate
#       Optional current-character cap. This is separate from AccountUnlocks.
#       Once this character reaches MaxLevel.Level, the allowed maximum for that rate is lowered
#       to MaxLevel.MaxRate. Saved values above that cap are automatically clamped while the cap is
#       active; saved values at or below the cap keep their original value.
#
# What is included:
#   - XP from kills, quests, Dungeon Finder quests, exploration, battleground kills, and
#     battleground bonus XP.
#   - XP level brackets: 1-9, 10-19, 20-29, 30-39, 40-49, 50-59, 60-69, 70-79, and 80.
#   - Weapon and defense skill gain.
#   - Profession skill gain for crafting, gathering, primary, secondary, herbalism, mining,
#     skinning, and fishing.
#   - Reputation split into global, kill, quest, and other sources.
#   - Honor and arena point rewards where the available hooks expose them.
#   - Drop chance multipliers for quality groups, quest items, recipes, pets, mounts, referenced
#     loot, and a general drop chance multiplier.
#   - Loot money.
#   - Account rates, optional character-specific overrides, account unlock ladders, per-character
#     max-level caps, and XP locking.
###################################################################################################

###################################################################################################
# MODULE OPTIONS
###################################################################################################

#
# IndividualRates.Enabled
#
#   Description:
#       Master switch for the module.
#
#   Default:
#       1 - Enabled
#
IndividualRates.Enabled = 1

#
# IndividualRates.Announce
#
#   Description:
#       Shows a short login message telling players the Individual Rates module is available.
#
#   Default:
#       1 - Enabled
#
IndividualRates.Announce = 1

#
# IndividualRates.AnnounceRatesOnLogin
#
#   Description:
#       Shows the player's currently enabled, supported rates at login.
#       Disable this if the login chat becomes too noisy.
#
#   Default:
#       1 - Enabled
#
IndividualRates.AnnounceRatesOnLogin = 1

#
# IndividualRates.MigrateIndividualXp.Enabled
#
#   Description:
#       Compatibility import for servers replacing mod-individual-xp.
#       This only runs when IndividualRates.CharacterRates.Enabled is 1.
#
#       If the old `individualxp` character table exists and a character has no rows yet in the
#       new `individual_rates` table, the old `XPRate` value is copied into the supported XP source
#       rates as character overrides: xp.kill, xp.quest, xp.quest.df, xp.explore,
#       xp.battlegroundbonus, and battleground kill XP rates.
#
#       XP level bracket rates are left at their defaults because they multiply with source rates.
#
#       Existing Individual Rates rows are never overwritten.
#
#   Default:
#       1 - Enabled
#
IndividualRates.MigrateIndividualXp.Enabled = 1

#
# IndividualRates.CharacterRates.Enabled
#
#   Description:
#       Enables per-character rate overrides.
#
#       When this is 0:
#           `.rate character set ...` is unavailable.
#           Saved rows in `individual_rates` are ignored.
#           Account rates, when enabled, become the normal player-selected values.
#
#       When this is 1:
#           `.rate character set <key|category> <value>` stores a character-specific override.
#           Character overrides have higher priority than account rates.
#           `.rate character default <key>` removes a character override and falls back to the
#           account value or server default.
#
#   Default:
#       0 - Character-specific overrides are disabled.
#
IndividualRates.CharacterRates.Enabled = 0

#
# IndividualRates.AccountRates.Enabled
#
#   Description:
#       Enables account-wide rate overrides.
#
#       When this is 0:
#           `.rate set <key> <value>` can only work if IndividualRates.SetCommand.AccountDefault
#           is 0 and IndividualRates.CharacterRates.Enabled is 1.
#           `.rate account set ...` is unavailable.
#
#       When this is 1:
#           `.rate set <key> <value>` stores an account-wide value by default.
#           `.rate account set <key|category> <value>` stores an account-wide override.
#           Account values are shared by all characters on the account.
#           Character overrides still have higher priority when character rates are enabled.
#
#   Default:
#       1 - Account-wide overrides are available in this config.
#
IndividualRates.AccountRates.Enabled = 1

#
# IndividualRates.SetCommand.AccountDefault
#
#   Description:
#       Chooses what `.rate set`, `.rate setall`, `.rate default`, `.rate enable`, and
#       `.rate disable` modify.
#
#       1 - These commands modify account rates. This is the recommended account-first setup.
#       0 - These commands modify character rates. This requires IndividualRates.CharacterRates.
#
#       The explicit commands always keep their target:
#           `.rate account set ...` always writes account rates.
#           `.rate character set ...` always writes character overrides.
#
#   Default:
#       1 - `.rate set` uses account rates.
#
IndividualRates.SetCommand.AccountDefault = 1

#
# IndividualRates.AccountUnlocks.Enabled
#
#   Description:
#       Global master switch for all category and individual Unlock settings.
#
#       This exists so owners can keep Unlock settings configured per category or per rate, while
#       still turning the whole account-unlock system on or off in one place.
#
#       Account unlocks use the highest-level character on the account. They are designed for
#       realms where the first character levels at normal/default rates, then later characters on
#       that same account can unlock higher rates.
#
#       This does not make rates account-wide by itself. Use IndividualRates.AccountRates.Enabled
#       for account-wide storage. This also does not control MaxLevel caps; MaxLevel works even
#       when AccountUnlocks is 0.
#
#       Simple mode example:
#           IndividualRates.Rate.XP.Kill.Unlock.Enabled = 1
#           IndividualRates.Rate.XP.Kill.Unlock.Level = 80
#           IndividualRates.Rate.XP.Kill.Unlock.Steps =
#
#       With that setup, players can set xp.kill above Default only after one character on the
#       account reaches level 80. Once unlocked, all characters on that account can use the higher
#       xp.kill rate, up to the configured Max.
#
#       If IndividualRates.Rate.XP.Kill.Unlock.Enabled = 0, that rate's unlock rule is ignored.
#       The player may use the rate up to Max unless a category unlock or MaxLevel cap applies.
#
#       Step mode example:
#           IndividualRates.Rate.XP.Kill.Unlock.Steps = 2:10,3:20,4:30,5:40,6:50,7:60,8:70,9:80
#
#       Each step is RateX:UnlockLevel. If one character on the account reaches the UnlockLevel,
#       that RateX becomes available to the account and all other characters on it. With the
#       example above, level 10 unlocks x2, level 20 unlocks x3, and level 80 unlocks x9.
#
#       Keep Unlock.Steps empty to use Unlock.Level. If Unlock.Steps is filled in, it always takes
#       priority over Unlock.Level. Rate-specific unlocks take precedence over category unlocks.
#
#   Default:
#       0 - Unlock requirements are ignored.
#
IndividualRates.AccountUnlocks.Enabled = 0

###################################################################################################
# CATEGORY OPTIONS
#
# These switches disable whole groups at the top level. Disabled categories are hidden from
# `.rate view` / `.rate list` and cannot be changed with `.rate set`.
#
# Category commands:
#   .rate set xp 5
#       Sets every enabled individual rate in the XP category to x5.
#
#   .rate set xplevel 0.5
#       Sets every enabled XP level bracket to x0.5.
#
#   .rate character set drops 2
#       Sets character-specific drop overrides when character rates are enabled.
#
#   .rate character reset drops
#       Removes character-specific drop overrides and falls back to account rates/defaults.
#
#   .rate reset drops
#       Removes both account and character drop overrides and returns to server defaults.
#
# For every category below:
#   Enabled
#       1 lets players view and change rates in this category.
#       0 hides every rate in this category and blocks player changes.
#
#   Unlock.Enabled / Unlock.Level / Unlock.Steps
#       Optional account-wide progression gate. It uses the highest-level character on the account
#       to decide how high players may set rates in this category.
#       This requires IndividualRates.AccountUnlocks.Enabled = 1.
#
#   MaxLevel.Enabled / MaxLevel.Level / MaxLevel.MaxRate
#       Optional per-character cap. Once this character reaches MaxLevel.Level, rates in this
#       category cannot go above MaxLevel.MaxRate. This cap applies even when account unlocks are
#       disabled.
#
###################################################################################################

#
# IndividualRates.Category.XP
#
#   Controls XP source rates such as xp.kill, xp.quest, xp.explore, battleground XP, and
#   battleground kill XP. These rates are separate from the per-level XP multipliers below.
#
#   Commands:
#       .rate set xp <0..rate max>
#       .rate account set xp <0..rate max>
#       .rate character set xp <0..rate max>
#
#   Defaults:
#       Enabled = 1, Unlock = off, Unlock.Level = 80, Unlock.Steps = empty,
#       MaxLevel = off, MaxLevel.Level = 70, MaxLevel.MaxRate = 3.
#
IndividualRates.Category.XP.Enabled = 1

IndividualRates.Category.XP.Unlock.Enabled = 0
IndividualRates.Category.XP.Unlock.Level = 80
IndividualRates.Category.XP.Unlock.Steps =

IndividualRates.Category.XP.MaxLevel.Enabled = 0
IndividualRates.Category.XP.MaxLevel.Level = 70
IndividualRates.Category.XP.MaxLevel.MaxRate = 3

#
# IndividualRates.Category.XP.Level
#
#   Controls per-level XP multipliers from xp.level.1-9 through xp.level.80. These multiply with
#   the selected XP source rate, so they can be used for bracket-based progression.
#
#   Commands:
#       .rate set xplevel <0..rate max>
#       .rate set xp.level.70-79 <0..10>
#
#   Defaults:
#       Enabled = 1, Unlock = off, Unlock.Level = 80, Unlock.Steps = empty,
#       MaxLevel = off, MaxLevel.Level = 70, MaxLevel.MaxRate = 3.
#
IndividualRates.Category.XP.Level.Enabled = 1

IndividualRates.Category.XP.Level.Unlock.Enabled = 0
IndividualRates.Category.XP.Level.Unlock.Level = 80
IndividualRates.Category.XP.Level.Unlock.Steps =

IndividualRates.Category.XP.Level.MaxLevel.Enabled = 0
IndividualRates.Category.XP.Level.MaxLevel.Level = 70
IndividualRates.Category.XP.Level.MaxLevel.MaxRate = 3

#
# IndividualRates.Category.CombatSkills
#
#   Controls weapon and defense skill gain rates. Disable this category to hide both combat skill
#   rates from player commands.
#
#   Commands:
#       .rate set combat <0..10>
#       .rate set skill.weapon <0..10>
#       .rate set skill.defense <0..10>
#
IndividualRates.Category.CombatSkills.Enabled = 1

IndividualRates.Category.CombatSkills.Unlock.Enabled = 0
IndividualRates.Category.CombatSkills.Unlock.Level = 80
IndividualRates.Category.CombatSkills.Unlock.Steps =

IndividualRates.Category.CombatSkills.MaxLevel.Enabled = 0
IndividualRates.Category.CombatSkills.MaxLevel.Level = 70
IndividualRates.Category.CombatSkills.MaxLevel.MaxRate = 3

#
# IndividualRates.Category.Professions
#
#   Controls profession skill gain rates, including gathering, crafting, primary, secondary, and
#   profession-specific entries. Crafted item output is not multiplied by this category.
#
#   Commands:
#       .rate set professions <0..10>
#       .rate set skill.gathering <0..10>
#       .rate set skill.crafting <0..10>
#
IndividualRates.Category.Professions.Enabled = 1

IndividualRates.Category.Professions.Unlock.Enabled = 0
IndividualRates.Category.Professions.Unlock.Level = 80
IndividualRates.Category.Professions.Unlock.Steps =

IndividualRates.Category.Professions.MaxLevel.Enabled = 0
IndividualRates.Category.Professions.MaxLevel.Level = 70
IndividualRates.Category.Professions.MaxLevel.MaxRate = 3

#
# IndividualRates.Category.Reputation
#
#   Controls global reputation plus kill, quest, and other reputation source rates. Disable this
#   category to force all personal reputation rates back to server defaults.
#
#   Commands:
#       .rate set reputation <0..10>
#       .rate set rep.global <0..10>
#
IndividualRates.Category.Reputation.Enabled = 1

IndividualRates.Category.Reputation.Unlock.Enabled = 0
IndividualRates.Category.Reputation.Unlock.Level = 80
IndividualRates.Category.Reputation.Unlock.Steps =

IndividualRates.Category.Reputation.MaxLevel.Enabled = 0
IndividualRates.Category.Reputation.MaxLevel.Level = 70
IndividualRates.Category.Reputation.MaxLevel.MaxRate = 3

#
# IndividualRates.Category.PvP
#
#   Controls PvP reward rates, including honor and arena points.
#
#   Commands:
#       .rate set pvp <0..10>
#       .rate set honor <0..10>
#       .rate set arenapoints <0..10>
#
IndividualRates.Category.PvP.Enabled = 1

IndividualRates.Category.PvP.Unlock.Enabled = 0
IndividualRates.Category.PvP.Unlock.Level = 80
IndividualRates.Category.PvP.Unlock.Steps =

IndividualRates.Category.PvP.MaxLevel.Enabled = 0
IndividualRates.Category.PvP.MaxLevel.Level = 70
IndividualRates.Category.PvP.MaxLevel.MaxRate = 3

#
# IndividualRates.Category.Drops
#
#   Controls personal drop chance rates such as item quality, quest items, recipes, pets, mounts,
#   referenced loot, and the general drop chance multiplier.
#
#   Commands:
#       .rate set drops <0..20>
#       .rate set drop.chance <0..20>
#       .rate set drop.mount <0..20>
#
#   MaxLevel example:
#       The default below enables a level 70 cap for the whole Drops category. Once the current
#       character reaches level 70, drop rates in this category cannot act above x3. If a saved
#       value is higher than x3, the module automatically uses x3 while the cap is active. Values
#       already at or below x3 keep their original value.
#
IndividualRates.Category.Drops.Enabled = 1

IndividualRates.Category.Drops.Unlock.Enabled = 0
IndividualRates.Category.Drops.Unlock.Level = 80
IndividualRates.Category.Drops.Unlock.Steps =

IndividualRates.Category.Drops.MaxLevel.Enabled = 1
IndividualRates.Category.Drops.MaxLevel.Level = 70
IndividualRates.Category.Drops.MaxLevel.MaxRate = 3

#
# IndividualRates.Category.Money
#
#   Controls personal money rates, currently loot money.
#
#   Commands:
#       .rate set money <0..20>
#       .rate set drop.money <0..20>
#
IndividualRates.Category.Money.Enabled = 1

IndividualRates.Category.Money.Unlock.Enabled = 0
IndividualRates.Category.Money.Unlock.Level = 80
IndividualRates.Category.Money.Unlock.Steps =

IndividualRates.Category.Money.MaxLevel.Enabled = 0
IndividualRates.Category.Money.MaxLevel.Level = 70
IndividualRates.Category.Money.MaxLevel.MaxRate = 3

###################################################################################################
# EXPERIENCE RATES
#
# Each individual rate below has three basic controls:
#   Enabled - whether players can see and change this exact rate with commands.
#   Default - the value used for new characters and `.rate default <key>`.
#   Max - the normal maximum value players may set.
#
# Player command syntax for every individual rate:
#   .rate set <player key> <value>
#       Sets the default storage target. In this config that means account rates.
#
#   .rate account set <player key> <value>
#       Sets the account value directly.
#
#   .rate character set <player key> <value>
#       Sets a character override. Character overrides take priority over account values.
#
#   .rate character reset <player key>
#       Removes the character override and returns that character to the account value/default.
#
#   .rate reset <player key>
#       Removes account and character overrides and returns to this config's Default.
#
# Values:
#   Players may use any value from 0 up to that rate's allowed maximum. The allowed maximum is the
#   lowest active limit from Max, Account Unlocks, and MaxLevel. Decimal values like 1.3 and 0.5
#   are valid.
#
# Each individual rate also has optional unlock and max-level controls:
#   Unlock.Enabled - use account progression for this exact rate.
#   Unlock.Level - require one character on the account to reach this level before Max is allowed.
#   Unlock.Steps - unlock specific maximum rates at specific account levels. Empty means use
#                  Unlock.Level. If filled in, this takes priority over Unlock.Level.
#   MaxLevel.Enabled - lower the allowed maximum when this character reaches MaxLevel.Level.
#   MaxLevel.Level - the character level where the lower maximum starts.
#   MaxLevel.MaxRate - the maximum allowed after that character reaches MaxLevel.Level.
#
# Rate-specific Unlock and MaxLevel settings override the category settings above when enabled.
###################################################################################################

#
#   Optional account unlock examples:
#
#       Require one character on the account to be level 80 before xp.kill can go above Default:
#           IndividualRates.Rate.XP.Kill.Unlock.Enabled = 1
#           IndividualRates.Rate.XP.Kill.Unlock.Level = 80
#
#       Unlock specific xp.kill rates at specific account levels:
#           IndividualRates.Rate.XP.Kill.Unlock.Enabled = 1
#           IndividualRates.Rate.XP.Kill.Unlock.Steps = 2:10,3:20,4:30,5:40,6:50,7:60,8:70,9:80
#
#       Limit only xp.kill to MaxLevel.MaxRate once this character reaches MaxLevel.Level:
#           IndividualRates.Rate.XP.Kill.MaxLevel.Enabled = 1
#           IndividualRates.Rate.XP.Kill.MaxLevel.Level = 70
#           IndividualRates.Rate.XP.Kill.MaxLevel.MaxRate = 3
#

#
# IndividualRates.Rate.XP.Kill
#
#   Player key:
#       xp.kill
#
#   Description:
#       Personal XP multiplier for normal creature kills outside battleground-specific XP maps.
#       This covers XP awarded through the normal kill XP source, such as outdoor and dungeon
#       non-player creature kills. Battleground honorable-kill XP uses the battleground-specific
#       XP rates below instead.
#
#   Default:
#       Default = 1
#       Max     = 10
#
IndividualRates.Rate.XP.Kill.Enabled = 1
IndividualRates.Rate.XP.Kill.Default = 1
IndividualRates.Rate.XP.Kill.Max = 10

IndividualRates.Rate.XP.Kill.Unlock.Enabled = 0
IndividualRates.Rate.XP.Kill.Unlock.Level = 80
IndividualRates.Rate.XP.Kill.Unlock.Steps =

IndividualRates.Rate.XP.Kill.MaxLevel.Enabled = 0
IndividualRates.Rate.XP.Kill.MaxLevel.Level = 70
IndividualRates.Rate.XP.Kill.MaxLevel.MaxRate = 3

#
# IndividualRates.Rate.XP.Quest
#
#   Player key:
#       xp.quest
#
#   Description:
#       Personal XP multiplier for normal quest turn-ins.
#       The quest window and the actual reward are both adjusted by this module.
#       Dungeon Finder/LFG quest rewards use xp.quest.df instead.
#
#   Default:
#       Default = 1
#       Max     = 10
#
IndividualRates.Rate.XP.Quest.Enabled = 1
IndividualRates.Rate.XP.Quest.Default = 1
IndividualRates.Rate.XP.Quest.Max = 10

IndividualRates.Rate.XP.Quest.Unlock.Enabled = 0
IndividualRates.Rate.XP.Quest.Unlock.Level = 80
IndividualRates.Rate.XP.Quest.Unlock.Steps =

IndividualRates.Rate.XP.Quest.MaxLevel.Enabled = 0
IndividualRates.Rate.XP.Quest.MaxLevel.Level = 70
IndividualRates.Rate.XP.Quest.MaxLevel.MaxRate = 3

#
# IndividualRates.Rate.XP.Quest.DF
#
#   Player key:
#       xp.quest.df
#
#   Description:
#       Personal XP multiplier for Dungeon Finder/LFG quest rewards.
#       This is separate from normal quest turn-ins so owners can keep dungeon finder rewards on a
#       different progression curve.
#
#   Default:
#       Default = 1
#       Max     = 10
#
IndividualRates.Rate.XP.Quest.DF.Enabled = 1
IndividualRates.Rate.XP.Quest.DF.Default = 1
IndividualRates.Rate.XP.Quest.DF.Max = 10

IndividualRates.Rate.XP.Quest.DF.Unlock.Enabled = 0
IndividualRates.Rate.XP.Quest.DF.Unlock.Level = 80
IndividualRates.Rate.XP.Quest.DF.Unlock.Steps =

IndividualRates.Rate.XP.Quest.DF.MaxLevel.Enabled = 0
IndividualRates.Rate.XP.Quest.DF.MaxLevel.Level = 70
IndividualRates.Rate.XP.Quest.DF.MaxLevel.MaxRate = 3

#
# IndividualRates.Rate.XP.Explore
#
#   Player key:
#       xp.explore
#
#   Description:
#       Personal XP multiplier for discovering/exploring areas.
#       This applies when the core awards XP from the exploration XP source.
#
#   Default:
#       Default = 1
#       Max     = 10
#
IndividualRates.Rate.XP.Explore.Enabled = 1
IndividualRates.Rate.XP.Explore.Default = 1
IndividualRates.Rate.XP.Explore.Max = 10

IndividualRates.Rate.XP.Explore.Unlock.Enabled = 0
IndividualRates.Rate.XP.Explore.Unlock.Level = 80
IndividualRates.Rate.XP.Explore.Unlock.Steps =

IndividualRates.Rate.XP.Explore.MaxLevel.Enabled = 0
IndividualRates.Rate.XP.Explore.MaxLevel.Level = 70
IndividualRates.Rate.XP.Explore.MaxLevel.MaxRate = 3

#
# IndividualRates.Rate.XP.BattlegroundBonus
#
#   Player key:
#       xp.battlegroundbonus
#
#   Description:
#       Personal XP multiplier for bonus battleground XP derived from honor rewards.
#       This is separate from battleground honorable-kill XP.
#       Use this for end-of-objective or bonus-style battleground XP that does not come from
#       killing another player.
#
#   Default:
#       Default = 1
#       Max     = 10
#
IndividualRates.Rate.XP.BattlegroundBonus.Enabled = 1
IndividualRates.Rate.XP.BattlegroundBonus.Default = 1
IndividualRates.Rate.XP.BattlegroundBonus.Max = 10

IndividualRates.Rate.XP.BattlegroundBonus.Unlock.Enabled = 0
IndividualRates.Rate.XP.BattlegroundBonus.Unlock.Level = 80

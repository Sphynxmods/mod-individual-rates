###################################################################################################
# EXPERIENCE LEVEL BRACKETS
#
# These are player-changeable XP multipliers for the character's current level bracket.
# They multiply together with the XP source rates above.
#
# Example:
#   Rate.XP.Kill is 1 globally.
#   A player sets `.rate set xp.kill 2`.
#   The same player sets `.rate set xp.level.20-29 0.5`.
#   While level 20-29, kill XP becomes 1x normal because 2 * 0.5 = 1.
#
# This makes it possible to run smooth progression curves such as:
#   1-9 faster, 10-59 normal, 60-80 slower
# without asking players to manually change one global XP number every few levels.
###################################################################################################

#
# IndividualRates.Rate.XP.Level.1-9
#
#   Player key:
#       xp.level.1-9
#
#   Description:
#       Personal XP multiplier while the character is level 1 through 9.
#       Applies to supported player XP sources: kill, quest, dungeon finder quest, exploration,
#       battleground honorable-kill XP, and battleground bonus XP.
#
#   Default:
#       Default = 1
#       Max     = 10
#
IndividualRates.Rate.XP.Level.1-9.Enabled = 1
IndividualRates.Rate.XP.Level.1-9.Default = 1
IndividualRates.Rate.XP.Level.1-9.Max = 10

IndividualRates.Rate.XP.Level.1-9.Unlock.Enabled = 0
IndividualRates.Rate.XP.Level.1-9.Unlock.Level = 80
IndividualRates.Rate.XP.Level.1-9.Unlock.Steps =

IndividualRates.Rate.XP.Level.1-9.MaxLevel.Enabled = 0
IndividualRates.Rate.XP.Level.1-9.MaxLevel.Level = 70
IndividualRates.Rate.XP.Level.1-9.MaxLevel.MaxRate = 3

